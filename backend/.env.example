# Rename this file to .env and fill in your real values.
# Get DATABASE_URL from your Neon dashboard (Connection string, use the "pooled" one for Render).
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Port Render will set this automatically; used for local dev
PORT=5000
